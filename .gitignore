# 收集到的個人資料一律不進版控（個資法：不得落於公開 repo）
data/*.json
data/*.csv
data/*.xlsx
data/*.xls
reports/*.csv
reports/*.json
reports/*.xlsx
reports/*.xls
reports/*.zip
reports/*.pdf

# 任何本機匯出／隔離副本都不得進入公開 repo
exports/
private-data/
security-quarantine/

# 保留資料夾結構
!data/.gitkeep
!reports/.gitkeep

# 本機設定（含 token）不要外流
apps-script/.clasp.json
.env
.env.*
!.env.example
